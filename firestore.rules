rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow anyone to read restaurants, but only logged-in users to create/update
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      
      // Allow anyone to read ratings, but only logged-in users to create
      match /ratings/{ratingId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow update: if request.auth != null;
      }
    }
  }
}